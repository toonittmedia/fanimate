  <name>Fanimate</name>
  <summary>Free 2D character animation</summary>
  <description>
    <p>
      Fanimate is a free, open-source 2D character animation app: bone rigging with
      inverse kinematics and Smart Bones, vector drawing, frame-by-frame animation with
      onion skin and an X-sheet, lip sync from dialogue, and video export.
    </p>
    <p>It opens Moho and Adobe Animate projects, and Photoshop and SVG files.</p>
  </description>
  <launchable type="desktop-id">io.github.toonittmedia.Fanimate.desktop</launchable>
  <url type="homepage">https://github.com/toonittmedia/fanimate</url>
  <url type="bugtracker">https://github.com/toonittmedia/fanimate/issues</url>
